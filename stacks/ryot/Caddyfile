# Ryot — reverse proxy example
#
# Upstream: ryot listens on 8000 inside the container and is reachable by
# service name on dokploy-network.
#
# FRONTEND_URL in the stack must be set to https://ryot.munywele.co.ke to match
# this hostname, otherwise Ryot generates broken links.
#
# Do not enable this while Dokploy also has a domain route for this service.

ryot.munywele.co.ke {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy ryot:8000

	log {
		output stdout
		format console
	}
}
