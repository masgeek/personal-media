# Point this at the shared postgres service in this repository. The database
# itself must be created first; see stacks/ryot/README.md.
DATABASE_URL=postgresql+asyncpg://media:change_me@postgres:5432/ryot

# Generate with: openssl rand -hex 32
SERVER_ADMIN_ACCESS_TOKEN=

# Public URL. Must match the reverse proxy hostname exactly, otherwise Ryot
# generates broken links and failed redirects. The local-only host binding for
# this stack is 127.0.0.1:8950.
FRONTEND_URL=https://ryot.munywele.co.ke
