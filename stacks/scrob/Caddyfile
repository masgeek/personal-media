# Scrob — reverse proxy example
#
# Upstream: scrob listens on 7330 inside the container and is reachable by
# service name on dokploy-network.
#
# Do not enable this while Dokploy also has a domain route for this service.

scrob.munywele.co.ke {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy scrob:7330

	log {
		output stdout
		format console
	}
}
