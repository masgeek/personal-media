# Mealie — reverse proxy example
#
# Upstream: mealie listens on 9000 inside the container and is reachable by
# service name on dokploy-network.
#
# The stack also publishes 127.0.0.1:8925 for local-only access. That loopback
# binding is unaffected by Caddy and can be removed if it is not used.
#
# Mealie handles its own authentication. Set MEALIE__ALLOW_SIGNUP to false once
# the first account exists.
#
# Do not enable this while Dokploy also has a domain route for this service.

mealie.munywele.co.ke {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy mealie:9000

	log {
		output stdout
		format console
	}
}
