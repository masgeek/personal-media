# Yamtrack — reverse proxy example
#
# Upstream: the yamtrack container listens on 8000 inside the container and is
# reachable by service name on dokploy-network.
#
# Caddy must be attached to dokploy-network to resolve `yamtrack`, and
# track.munywele.co.ke must point at this host.
#
# Do not enable this while Dokploy also has a domain route for this service.
# Two proxies terminating TLS for the same hostname will conflict.

track.munywele.co.ke {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy yamtrack:8000

	log {
		output stdout
		format console
	}
}
